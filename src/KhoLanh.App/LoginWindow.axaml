<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KhoLanh.App.LoginWindow"
        Title="Kho Lạnh - Đăng nhập" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{DynamicResource CardBg}">
  <!-- Đăng nhập gọn (1.46): 1 cột, không nền / bảng bên cạnh, chỉ giữ chữ cần thiết (ghi chú chỉ hiện khi có việc cần báo). -->
  <StackPanel Margin="36,28,36,26" Spacing="6">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
      <Image Source="/Assets/logo.png" Width="44" Height="44" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="KHO LẠNH" FontSize="19" FontWeight="Bold"/>
        <TextBlock x:Name="VersionText" Classes="muted" FontSize="11.5"/>
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="Heading" Text="Đăng nhập" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="SubHeading" Classes="muted" TextWrapping="Wrap" IsVisible="False"/>
    <StackPanel x:Name="FullNamePanel" IsVisible="False" Spacing="3" Margin="0,6,0,0">
      <TextBlock Text="Họ tên" Classes="label"/>
      <TextBox x:Name="FullNameBox" Watermark="Ví dụ: Nguyễn Văn A"/>
    </StackPanel>
    <TextBlock Text="Tên đăng nhập" Classes="label" Margin="0,8,0,0"/>
    <TextBox x:Name="UserBox"/>
    <TextBlock Text="Mật khẩu" Classes="label" Margin="0,6,0,0"/>
    <TextBox x:Name="PassBox" PasswordChar="•"/>
    <StackPanel x:Name="ConfirmPanel" IsVisible="False">
      <TextBlock Text="Nhập lại mật khẩu" Classes="label" Margin="0,6,0,3"/>
      <TextBox x:Name="Pass2Box" PasswordChar="•"/>
    </StackPanel>
    <StackPanel x:Name="RememberPanel" Orientation="Horizontal" Spacing="18" Margin="0,6,0,0">
      <CheckBox x:Name="RememberBox" Content="Nhớ mật khẩu" IsCheckedChanged="OnRememberChanged"/>
      <CheckBox x:Name="AutoBox" Content="Tự động đăng nhập" IsCheckedChanged="OnAutoChanged"/>
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" IsVisible="False"/>
    <Button x:Name="LoginButton" Content="Đăng nhập" Classes="primary" IsDefault="True" MinHeight="36"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="OnLogin"/>
    <Button x:Name="GoogleButton" Content="Đăng nhập bằng Google" IsVisible="False" MinHeight="34"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnGoogle"
            ToolTip.Tip="Dùng tài khoản Google đang đăng nhập trên trình duyệt — Quản trị gán Gmail cho từng tài khoản ở Hệ thống › Tài khoản"/>
    <Button x:Name="JoinButton" Content="Dùng chung tài khoản với máy khác…" IsVisible="False"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnJoin"/>
    <StackPanel x:Name="UpdatePanel" IsVisible="False" Spacing="4" Margin="0,6,0,0">
      <TextBlock x:Name="UpdText" Classes="muted" TextWrapping="Wrap"/>
      <ProgressBar x:Name="UpdBar" Minimum="0" Maximum="100" Height="5" IsIndeterminate="True"/>
      <Button x:Name="SkipButton" Content="Bỏ qua, vào luôn" IsVisible="False" Classes="ghost" HorizontalAlignment="Right" Click="OnSkipUpdate"/>
    </StackPanel>
    <TextBlock x:Name="DataPathText" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="False"/>
  </StackPanel>
</Window>
