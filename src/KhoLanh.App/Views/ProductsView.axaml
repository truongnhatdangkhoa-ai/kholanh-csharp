<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.ProductsView">
  <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <TextBox x:Name="SearchBox" Width="280" Watermark="Tìm mã, tên, nhóm..."/>
          <CheckBox x:Name="InactiveBox" Content="Hiện mã ngừng dùng"/>
          <Button Content="Tìm" Click="OnSearch"/>
          <Button Content="+ Mã hàng mới" Classes="primary" Click="OnNew" x:Name="NewButton"/>
          <Button Content="Nạp từ Excel" Click="OnImport" x:Name="ImportButton"/>
          <Button Content="Xuất Excel" Click="OnExport"/>
        </WrapPanel>
      </Border>
      <TextBlock DockPanel.Dock="Bottom" x:Name="SummaryText" Classes="muted" Margin="0,8,0,0"/>
      <DataGrid x:Name="Grid" SelectionChanged="OnSelect">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mã hàng" Binding="{Binding Code}" Width="105"/>
          <DataGridTextColumn Header="Tên hàng" Binding="{Binding Name}" Width="*" MinWidth="180"/>
          <DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="85"/>
          <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="70"/>
          <DataGridTextColumn Header="Kg/ĐV" Binding="{Binding KgPerUnit, StringFormat='#,0.##'}" Width="75"/>
          <DataGridTextColumn Header="Size" Binding="{Binding Sizes}" Width="130"/>
          <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding MinStock, StringFormat='#,0.##'}" Width="120"/>
          <DataGridCheckBoxColumn Header="Đang dùng" Binding="{Binding IsActive}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <Border Grid.Column="1" Classes="card">
      <ScrollViewer>
        <StackPanel Spacing="4" x:Name="Form">
          <TextBlock x:Name="FormTitle" Text="Mã hàng mới" Classes="section"/>
          <TextBlock Text="Mã hàng *" Classes="label"/><TextBox x:Name="CodeBox"/>
          <TextBlock Text="Tên hàng *" Classes="label"/><TextBox x:Name="NameBox"/>
          <TextBlock Text="Nhóm hàng" Classes="label"/><TextBox x:Name="CategoryBox" Watermark="VD: Cá, Tôm, Mực"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel><TextBlock Text="Đơn vị tính" Classes="label"/><TextBox x:Name="UnitBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Kg / đơn vị" Classes="label"/><TextBox x:Name="KgBox" HorizontalContentAlignment="Right"/></StackPanel>
          </Grid>
          <TextBlock Text="Các size thường dùng (cách nhau bằng dấu phẩy)" Classes="label"/><TextBox x:Name="SizesBox" Watermark="VD: 120-170, 170-220, 220 UP"/>
          <TextBlock Text="Tồn tối thiểu (cảnh báo khi thấp hơn)" Classes="label"/><TextBox x:Name="MinBox" HorizontalContentAlignment="Right"/>
          <TextBlock Text="Ghi chú" Classes="label"/><TextBox x:Name="NoteBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
          <CheckBox x:Name="ActiveBox" Content="Đang dùng" IsChecked="True" Margin="0,6,0,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Lưu" Classes="primary" Click="OnSave" x:Name="SaveButton"/>
            <Button Content="Xóa" Classes="danger" Click="OnDelete" x:Name="DeleteButton"/>
          </StackPanel>
          <TextBlock x:Name="ReadOnlyText" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Bạn chỉ có quyền xem. Cần tài khoản Quản lý trở lên để sửa danh mục."/>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
