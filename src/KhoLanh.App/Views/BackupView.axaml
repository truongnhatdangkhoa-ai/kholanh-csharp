<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.BackupView">
  <!-- 1.56: gọn lại — bỏ Thông tin công ty (giữ Tên kho). 1.68: sao lưu chuyển sang Dữ liệu & sao lưu; trái: máy này · phải: cập nhật + tài khoản dùng chung. -->
  <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,6,0">
        <!-- Máy này: tên kho + nơi lưu dữ liệu -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Máy này" Classes="section"/>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Tên kho" VerticalAlignment="Center" Width="80"/>
              <TextBox Grid.Column="1" x:Name="WarehouseBox" Watermark="VD: Kho lạnh số 1" ToolTip.Tip="Hiện dưới chữ KHO LẠNH trên thanh menu"/>
              <Button Grid.Column="2" Content="Lưu" Click="OnSaveSettings"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Dữ liệu" VerticalAlignment="Center" Width="80"/>
              <TextBlock Grid.Column="1" x:Name="PathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Tag="keep"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="88,0,0,0">
              <Button Content="Mở thư mục dữ liệu" Click="OnOpenFolder"/>
              <Button Content="Đổi nơi lưu dữ liệu…" Click="OnChangeFolder"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- Khởi động cùng Windows -->
        <Border Classes="card">
          <StackPanel x:Name="BootPanel" Spacing="6"/>
        </Border>
        <!-- Chép từ app cũ -->
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Chép dữ liệu từ app cũ" Classes="section" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Chọn khokhanh.db và chép…" Click="OnImportLegacy"
                    ToolTip.Tip="Chép dữ liệu MỌI module của app cũ (Tồn kho, Lịch xuất, NXT Bột/Sốt, Phiếu xuất kho, Nhập liệu, Kiểm kê, Tổng hợp, Kháng sinh…) từ app › database › engine › khokhanh.db — chọn từng module trước khi chép. Chỉ đọc file cũ."/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 1.68: sao lưu / khôi phục chuyển sang Hệ thống › Dữ liệu & sao lưu › Sao lưu -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12" Margin="0,0,6,0">
        <!-- Cập nhật -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Cập nhật phần mềm" Classes="section" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpdRollbackButton" Content="Quay lại bản trước" Click="OnUpdRollback"/>
                <Button Content="Kiểm tra cập nhật" Classes="primary" Click="OnUpdCheck"
                        ToolTip.Tip="Phần mềm tự hỏi GitHub lúc mở và mỗi 30 phút, tải ngầm bản mới; dữ liệu giữ nguyên."/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="UpdVersionText" TextWrapping="Wrap" Tag="keep"/>
            <StackPanel x:Name="UpdConfigPanel" Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                <TextBlock Text="Kho GitHub" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="UpdRepoBox"/>
                <TextBlock Grid.Column="2" Text="Mã truy cập" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Token chỉ-đọc, cần khi kho riêng tư"/>
                <TextBox Grid.Column="3" x:Name="UpdTokenBox" PasswordChar="•" Watermark="Để trống = giữ mã đã lưu"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <CheckBox x:Name="UpdAutoBox" Content="Tự động kiểm tra và tải bản mới"/>
                <Button x:Name="UpdSaveButton" Content="Lưu" Click="OnUpdSave"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="UpdStatus" Classes="muted" TextWrapping="Wrap" Tag="keep"/>
          </StackPanel>
        </Border>
        <!-- Tài khoản dùng chung -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Tài khoản dùng chung (Google Sheet)" Classes="section"/>
            <TextBlock x:Name="AcctStatus" TextWrapping="Wrap" Tag="keep"/>
            <StackPanel x:Name="AcctSetupPanel" Spacing="6">
              <Expander Header="Hướng dẫn kết nối lần đầu" HorizontalAlignment="Stretch">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Tag="keep"
                           Text="Máy quản trị: (1) bấm Tạo mã Apps Script (mã được chép sẵn); (2) tạo Google Sheet trống › Tiện ích mở rộng › Apps Script, xóa hết, dán, Lưu; (3) Triển khai › Tùy chọn triển khai mới › Ứng dụng web, Thực thi: Tôi, Ai có quyền truy cập: Bất kỳ ai › Triển khai, chép đường dẫn …/exec; (4) dán vào ô dưới, bấm Kết nối. Máy khác: dán mã kết nối KLTK1-… rồi bấm Kết nối."/>
              </Expander>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox x:Name="AcctInput" Watermark="Đường dẫn Web App (…/exec) hoặc mã kết nối KLTK1-…"/>
                <Button Grid.Column="1" x:Name="AcctScriptButton" Content="Tạo mã Apps Script" Click="OnAcctScript" ToolTip.Tip="Tự chép vào bộ nhớ"/>
                <Button Grid.Column="2" Content="Kết nối" Classes="primary" Click="OnAcctConnect"/>
              </Grid>
            </StackPanel>
            <WrapPanel x:Name="AcctOnPanel" ItemSpacing="8" LineSpacing="8">
              <Button Content="Đồng bộ ngay" Click="OnAcctPull"/>
              <Button Content="Tạo bộ cài cho máy mới…" Click="OnAcctBundle"/>
              <Button Content="Chép mã máy nhân viên" Click="OnAcctCodeStaff"/>
              <Button Content="Cập nhật mã Apps Script" Click="OnAcctUpgrade" ToolTip.Tip="Mã Apps Script bản mới, giữ nguyên mã kết nối (1.70: thêm cột Email Google). Dán đè rồi Triển khai › Quản lý triển khai › Phiên bản mới."/>
              <Button x:Name="AcctCodeAdminButton" Content="Chép mã máy quản trị" Click="OnAcctCodeAdmin"/>
              <Button Content="Ngắt kết nối" Classes="danger" Click="OnAcctDisconnect"/>
            </WrapPanel>
            <TextBlock x:Name="AcctMsg" Classes="muted" TextWrapping="Wrap" Tag="keep"/>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Sao lưu, khôi phục, đồng bộ LAN / Drive" Classes="section" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Mở Dữ liệu &amp; sao lưu" Click="OnOpenDuLieu"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
