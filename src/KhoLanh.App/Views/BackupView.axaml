<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.BackupView">
  <!-- 1.105: gọn — chỉ còn việc của máy này. 1.56: gọn lại — bỏ Thông tin công ty (giữ Tên kho). 1.68: sao lưu chuyển sang Dữ liệu & sao lưu; trái: máy này · phải: cập nhật + tài khoản dùng chung. -->
  <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
    <ScrollViewer>
      <StackPanel Spacing="12" Margin="0,0,6,0">
        <!-- Máy này: tên kho + nơi lưu dữ liệu -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Máy này" Classes="section"/>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <TextBlock Text="Tên kho" VerticalAlignment="Center" Width="80"/>
              <TextBox Grid.Column="1" x:Name="WarehouseBox" Watermark="VD: Kho lạnh số 1" ToolTip.Tip="Hiện dưới chữ KHO LẠNH trên thanh menu"/>
              <Button Grid.Column="2" Content="Lưu" Click="OnSaveSettings"/>
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
              <TextBlock Text="Dữ liệu" VerticalAlignment="Center" Width="80"/>
              <TextBlock Grid.Column="1" x:Name="PathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Tag="keep"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="88,0,0,0">
              <Button Content="Mở thư mục dữ liệu" Click="OnOpenFolder"/>
              <Button Content="Đổi nơi lưu dữ liệu…" Click="OnChangeFolder"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- Khởi động cùng Windows -->
        <Border Classes="card">
          <StackPanel x:Name="BootPanel" Spacing="6"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- 1.68: sao lưu / khôi phục chuyển sang Hệ thống › Dữ liệu & sao lưu › Sao lưu -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Spacing="12" Margin="0,0,6,0">
        <!-- Cập nhật -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Cập nhật phần mềm" Classes="section" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpdRollbackButton" Content="Quay lại bản trước" Click="OnUpdRollback"/>
                <Button Content="Kiểm tra cập nhật" Classes="primary" Click="OnUpdCheck"
                        ToolTip.Tip="Phần mềm tự hỏi GitHub lúc mở và mỗi 30 phút, tải ngầm bản mới; dữ liệu giữ nguyên."/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="UpdVersionText" TextWrapping="Wrap" Tag="keep"/>
            <!-- 1.105: kho GitHub + mã truy cập chuyển sang Hệ thống › Kết nối › Cập nhật phần mềm -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <CheckBox x:Name="UpdAutoBox" Content="Tự tải và cài bản mới" IsCheckedChanged="OnUpdAuto"/>
            </StackPanel>
            <TextBlock x:Name="UpdStatus" Classes="muted" TextWrapping="Wrap" Tag="keep"/>
          </StackPanel>
        </Border>
        <!-- 1.105: tài khoản dùng chung → Hệ thống › Kết nối; đồng bộ / sao lưu / điện thoại → Hệ thống › Đồng bộ & sao lưu -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Đã chuyển đi chỗ khác" Classes="section"/>
            <TextBlock Classes="muted" TextWrapping="Wrap" Tag="keep" Text="Tài khoản dùng chung, mã điện thoại, mã GitHub, Gmail → Hệ thống › Kết nối. Đồng bộ giữa các máy, điện thoại, sao lưu → Hệ thống › Đồng bộ &amp; sao lưu."/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Mở Kết nối" Click="OnGoKetNoi"/>
              <Button Content="Mở Đồng bộ &amp; sao lưu" Click="OnGoDongBo"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- 1.98: bỏ khung "Sao lưu, khôi phục, đồng bộ LAN / Drive" — đã có ở Hệ thống › Dữ liệu & sao lưu -->
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
