<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.BackupView">
  <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
    <StackPanel Spacing="16">
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Text="Thông tin in trên phiếu" Classes="section"/>
          <TextBlock Text="Tên công ty" Classes="label"/><TextBox x:Name="CompanyBox"/>
          <TextBlock Text="Địa chỉ" Classes="label"/><TextBox x:Name="AddressBox"/>
          <TextBlock Text="Tên kho" Classes="label"/><TextBox x:Name="WarehouseBox" Watermark="VD: Kho lạnh số 1"/>
          <Button Content="Lưu thông tin" Classes="primary" Click="OnSaveSettings" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Dữ liệu" Classes="section"/>
          <TextBlock x:Name="PathText" TextWrapping="Wrap"/>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Dữ liệu của phần mềm này nằm riêng, không dùng chung và không ảnh hưởng tới phần mềm kho cũ."/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Mở thư mục dữ liệu" Click="OnOpenFolder"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Chép dữ liệu Tồn kho An An / Tồn kho gửi từ app cũ" Classes="section"/>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Chép Đặc tính, điều kiện lọc, chuyển mã thủ công, phiếu xuất, số liệu ngoài sổ sách và dữ liệu đã nạp của 2 module từ file database app cũ (thư mục app cũ › app › database › engine › khokhanh.db). Chỉ ĐỌC file cũ, không sửa gì bên app cũ. Dữ liệu 2 module hiện có trong app mới sẽ được thay bằng bản chép."/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Chọn khokhanh.db và chép..." Click="OnImportLegacy"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Grid.Column="1" Classes="card">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
          <TextBlock Text="Sao lưu và khôi phục" Classes="section"/>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Mỗi ngày, lần mở phần mềm đầu tiên sẽ tự sao lưu (giữ 30 bản gần nhất). Nên chép thêm bản sao lưu ra USB hoặc Google Drive định kỳ."/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Sao lưu ra file..." Classes="primary" Click="OnBackup"/>
            <Button x:Name="RestoreFileButton" Content="Khôi phục từ file..." Classes="danger" Click="OnRestoreFile"/>
          </StackPanel>
          <TextBlock Text="Các bản sao lưu tự động" Classes="label" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
          <Button x:Name="RestoreSelButton" Content="Khôi phục bản đang chọn" Classes="danger" Click="OnRestoreSelected"/>
        </StackPanel>
        <DataGrid x:Name="Grid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tên file" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="Thời gian" Binding="{Binding LastWriteTime, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
            <DataGridTextColumn Header="Dung lượng (KB)" Binding="{Binding Kb}" Width="130"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
