<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.StockView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
      <WrapPanel ItemSpacing="10" LineSpacing="8">
        <StackPanel><TextBlock Text="Chủ hàng" Classes="label"/><ComboBox x:Name="OwnerBox" Width="220" DisplayMemberBinding="{Binding Display}"/></StackPanel>
        <StackPanel><TextBlock Text="Tìm mã hàng, tên, size, lô" Classes="label"/><TextBox x:Name="SearchBox" Width="260"/></StackPanel>
        <StackPanel><TextBlock Text="Vị trí bắt đầu bằng" Classes="label"/><TextBox x:Name="LocationBox" Width="140" Watermark="VD: A"/></StackPanel>
        <Button Content="Lọc" Classes="primary" Click="OnFilter" VerticalAlignment="Bottom"/>
        <Button Content="Xuất Excel" Click="OnExport" VerticalAlignment="Bottom"/>
      </WrapPanel>
    </Border>
    <TextBlock DockPanel.Dock="Bottom" x:Name="SummaryText" Classes="muted" Margin="0,8,0,0"/>
    <TabControl x:Name="Tabs">
      <TabItem Header="Chi tiết theo lô / vị trí">
        <DataGrid x:Name="DetailGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Chủ hàng" Binding="{Binding OwnerName}" Width="170"/>
            <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductCode}" Width="110"/>
            <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="*" MinWidth="160"/>
            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
            <DataGridTextColumn Header="Lô" Binding="{Binding Lot}" Width="110"/>
            <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="80"/>
            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="70"/>
            <DataGridTextColumn Header="Tồn" Binding="{Binding Quantity, StringFormat='#,0.##'}" Width="90"/>
            <DataGridTextColumn Header="Số kg" Binding="{Binding Weight, StringFormat='#,0.##'}" Width="100"/>
            <DataGridTextColumn Header="Nhập lần đầu" Binding="{Binding FirstIn, StringFormat='dd/MM/yyyy'}" Width="120"/>
            <DataGridTextColumn Header="Số ngày lưu" Binding="{Binding DaysInStock}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="Tổng theo mã hàng">
        <DataGrid x:Name="TotalGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductCode}" Width="120"/>
            <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="*"/>
            <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="80"/>
            <DataGridTextColumn Header="Tồn" Binding="{Binding Quantity, StringFormat='#,0.##'}" Width="100"/>
            <DataGridTextColumn Header="Số kg" Binding="{Binding Weight, StringFormat='#,0.##'}" Width="110"/>
            <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding MinStock, StringFormat='#,0.##'}" Width="110"/>
            <DataGridCheckBoxColumn Header="Dưới mức" Binding="{Binding IsLow}" Width="90"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
