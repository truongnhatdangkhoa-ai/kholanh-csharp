<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.VoucherEditView">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
    <!-- Thông tin chung -->
    <Border Classes="card">
      <Grid ColumnDefinitions="170,150,2*,2*,1.2*,2*" ColumnSpacing="12" RowDefinitions="Auto,Auto">
        <TextBlock Text="Số phiếu (dự kiến)" Classes="label"/>
        <TextBox Grid.Row="1" x:Name="NoBox" IsReadOnly="True" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="1" Text="Ngày" Classes="label"/>
        <CalendarDatePicker Grid.Row="1" Grid.Column="1" x:Name="DateBox" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="2" Text="Chủ hàng" Classes="label"/>
        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="OwnerBox" HorizontalAlignment="Stretch" DisplayMemberBinding="{Binding Display}"/>
        <TextBlock Grid.Column="3" x:Name="PartnerLabel" Text="Người giao hàng" Classes="label"/>
        <TextBox Grid.Row="1" Grid.Column="3" x:Name="PartnerBox"/>
        <TextBlock Grid.Column="4" Text="Số xe / container" Classes="label"/>
        <TextBox Grid.Row="1" Grid.Column="4" x:Name="VehicleBox"/>
        <TextBlock Grid.Column="5" Text="Ghi chú phiếu" Classes="label"/>
        <TextBox Grid.Row="1" Grid.Column="5" x:Name="NoteBox"/>
      </Grid>
    </Border>

    <!-- Nhập dòng hàng -->
    <Border Grid.Row="1" Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="2.6*,1.1*,1.1*,1*,0.9*,0.9*,1.4*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
          <TextBlock Text="Mã hàng (gõ mã hoặc tên)" Classes="label"/>
          <AutoCompleteBox Grid.Row="1" x:Name="ProductBox" FilterMode="Custom" MinimumPrefixLength="0" MaxDropDownHeight="320"/>
          <TextBlock Grid.Column="1" Text="Size" Classes="label"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="1" x:Name="SizeBox" FilterMode="ContainsOrdinal" MinimumPrefixLength="0"/>
          <TextBlock Grid.Column="2" Text="Lô" Classes="label"/>
          <TextBox Grid.Row="1" Grid.Column="2" x:Name="LotBox"/>
          <TextBlock Grid.Column="3" Text="Vị trí" Classes="label"/>
          <AutoCompleteBox Grid.Row="1" Grid.Column="3" x:Name="LocationBox" FilterMode="StartsWith" MinimumPrefixLength="0"/>
          <TextBlock Grid.Column="4" x:Name="QtyLabel" Text="Số lượng" Classes="label"/>
          <TextBox Grid.Row="1" Grid.Column="4" x:Name="QtyBox" HorizontalContentAlignment="Right"/>
          <TextBlock Grid.Column="5" Text="Số kg" Classes="label"/>
          <TextBox Grid.Row="1" Grid.Column="5" x:Name="KgBox" HorizontalContentAlignment="Right" Watermark="tự tính"/>
          <TextBlock Grid.Column="6" Text="Ghi chú dòng" Classes="label"/>
          <TextBox Grid.Row="1" Grid.Column="6" x:Name="LineNoteBox"/>
          <Button Grid.Row="1" Grid.Column="7" Content="+ Thêm dòng" Classes="primary" Click="OnAddLine"/>
        </Grid>
        <TextBlock x:Name="HintText" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Danh sách dòng + tồn có thể xuất -->
    <Grid Grid.Row="2" x:Name="BodyGrid" RowDefinitions="0,*" RowSpacing="0">
      <Border Grid.Row="1" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
            <TextBlock Text="Các dòng hàng trên phiếu" Classes="section"/>
            <TextBlock Grid.Column="1" x:Name="TotalText" FontWeight="SemiBold" Foreground="{StaticResource BrandMid}"/>
          </Grid>
          <DataGrid x:Name="LinesGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44"/>
              <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductCode}" Width="110"/>
              <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="*" MinWidth="150"/>
              <DataGridTextColumn Header="Size" Binding="{Binding Line.Size}" Width="90"/>
              <DataGridTextColumn Header="Lô" Binding="{Binding Line.Lot}" Width="100"/>
              <DataGridTextColumn Header="Vị trí" Binding="{Binding Line.Location}" Width="80"/>
              <DataGridTextColumn Header="Số lượng" Binding="{Binding Line.Quantity, StringFormat='#,0.##'}" Width="100"/>
              <DataGridTextColumn Header="Số kg" Binding="{Binding Line.Weight, StringFormat='#,0.##'}" Width="90"/>
              <DataGridTextColumn Header="Ghi chú" Binding="{Binding Line.Note}" Width="100"/>
              <DataGridTemplateColumn Header="" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="Xóa" Classes="danger" Padding="8,2" Click="OnRemoveLine" HorizontalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Row="0" x:Name="StockCard" Classes="card" IsVisible="False">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Tồn có thể xuất" Classes="section"/>
            <TextBlock Classes="muted" Margin="0,2,0,0" Text="(chọn mã hàng để xem tồn theo lô / vị trí, nhấp đúp một dòng để điền sẵn; lô nhập trước xếp trên)"/>
          </StackPanel>
          <DataGrid x:Name="StockGrid" DoubleTapped="OnPickStock">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
              <DataGridTextColumn Header="Lô" Binding="{Binding Lot}" Width="*"/>
              <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="120"/>
              <DataGridTextColumn Header="Tồn" Binding="{Binding Quantity, StringFormat='#,0.##'}" Width="110"/>
              <DataGridTextColumn Header="Số kg" Binding="{Binding Weight, StringFormat='#,0.##'}" Width="110"/>
              <DataGridTextColumn Header="Nhập ngày" Binding="{Binding FirstIn, StringFormat='dd/MM/yyyy'}" Width="120"/>
              <DataGridTextColumn Header="Số ngày" Binding="{Binding DaysInStock}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="Làm lại phiếu mới" Click="OnReset"/>
      <Button Content="Lưu phiếu (Ctrl+S)" Classes="primary" Click="OnSave"/>
      <Button Content="Lưu và in" Classes="primary" Click="OnSavePrint"/>
    </StackPanel>
  </Grid>
</UserControl>
