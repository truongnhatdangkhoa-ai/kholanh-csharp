<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.OwnersView">
  <Grid ColumnDefinitions="*,360" ColumnSpacing="16">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,14">
        <WrapPanel ItemSpacing="10" LineSpacing="8">
          <TextBox x:Name="SearchBox" Width="280" Watermark="Tìm mã, tên, điện thoại..."/>
          <CheckBox x:Name="InactiveBox" Content="Hiện chủ hàng ngừng dùng"/>
          <Button Content="Tìm" Click="OnSearch"/>
          <Button Content="+ Chủ hàng mới" Classes="primary" Click="OnNew" x:Name="NewButton"/>
        </WrapPanel>
      </Border>
      <TextBlock DockPanel.Dock="Bottom" x:Name="SummaryText" Classes="muted" Margin="0,8,0,0"/>
      <DataGrid x:Name="Grid" SelectionChanged="OnSelect">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110"/>
          <DataGridTextColumn Header="Tên chủ hàng" Binding="{Binding Name}" Width="*" MinWidth="180"/>
          <DataGridTextColumn Header="Điện thoại" Binding="{Binding Phone}" Width="130"/>
          <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="200"/>
          <DataGridCheckBoxColumn Header="Đang dùng" Binding="{Binding IsActive}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <Border Grid.Column="1" Classes="card">
      <StackPanel Spacing="4">
        <TextBlock x:Name="FormTitle" Text="Chủ hàng mới" Classes="section"/>
        <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="Chủ hàng là người sở hữu hàng trong kho (hàng của kho, hoặc hàng khách gửi). Tồn kho được tách theo chủ hàng."/>
        <TextBlock Text="Mã *" Classes="label"/><TextBox x:Name="CodeBox"/>
        <TextBlock Text="Tên *" Classes="label"/><TextBox x:Name="NameBox"/>
        <TextBlock Text="Điện thoại" Classes="label"/><TextBox x:Name="PhoneBox"/>
        <TextBlock Text="Địa chỉ" Classes="label"/><TextBox x:Name="AddressBox"/>
        <TextBlock Text="Ghi chú" Classes="label"/><TextBox x:Name="NoteBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
        <CheckBox x:Name="ActiveBox" Content="Đang dùng" IsChecked="True" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
          <Button Content="Lưu" Classes="primary" Click="OnSave" x:Name="SaveButton"/>
          <Button Content="Xóa" Classes="danger" Click="OnDelete" x:Name="DeleteButton"/>
        </StackPanel>
        <TextBlock x:Name="ReadOnlyText" Classes="muted" TextWrapping="Wrap" Margin="0,10,0,0"
                   Text="Bạn chỉ có quyền xem. Cần tài khoản Quản lý trở lên để sửa danh mục."/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
