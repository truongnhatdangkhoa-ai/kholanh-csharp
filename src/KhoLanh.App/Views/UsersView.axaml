<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.UsersView">
  <!-- 1.56: 2 tab — Danh sách tài khoản (bảng rộng) · Thông tin & phân quyền (form + bảng quyền rộng hết trang). Bấm đúp / Sửa → tab 2. -->
  <TabControl x:Name="Tabs">
    <TabItem Header="Danh sách tài khoản">
      <DockPanel Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
          <Button Content="+ Tài khoản mới" Classes="primary" Click="OnNew"/>
          <Button x:Name="EditButton" Content="Sửa tài khoản đang chọn" Click="OnEdit"/>
          <TextBlock x:Name="CountText" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" Tag="keep"/>
        </StackPanel>
        <DataGrid x:Name="List" IsReadOnly="True" DoubleTapped="OnListDoubleTapped">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="180"/>
            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*"/>
            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleLabel}" Width="170"/>
            <DataGridTextColumn Header="Email Google" Binding="{Binding GoogleEmail}" Width="220"/>
            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="120"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </TabItem>
    <TabItem Header="Thông tin &amp; phân quyền">
      <Border Classes="card" Padding="16,12" Margin="0,8,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock x:Name="FormTitle" Classes="section" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="← Danh sách" Click="OnBack"/>
              <Button x:Name="ResetButton" Content="Đặt lại mật khẩu" Click="OnReset"/>
              <Button Content="Lưu" Classes="primary" MinWidth="90" Click="OnSave"/>
            </StackPanel>
          </Grid>
          <WrapPanel DockPanel.Dock="Top" ItemSpacing="12" LineSpacing="8">
            <StackPanel Width="190" Spacing="3"><TextBlock Text="Tên đăng nhập *" Classes="label"/><TextBox x:Name="UserBox"/></StackPanel>
            <StackPanel Width="230" Spacing="3"><TextBlock Text="Họ tên" Classes="label"/><TextBox x:Name="NameBox"/></StackPanel>
            <StackPanel Width="150" Spacing="3">
              <TextBlock Text="Vai trò" Classes="label"/>
              <ComboBox x:Name="RoleBox" HorizontalAlignment="Stretch" SelectionChanged="OnRoleChanged">
                <ComboBoxItem Content="Nhân viên" Tag="staff"/>
                <ComboBoxItem Content="Quản lý" Tag="manager"/>
                <ComboBoxItem Content="Quản trị" Tag="admin"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Width="240" Spacing="3" ToolTip.Tip="Gmail của người dùng (đưa lên Google Sheet chung / app điện thoại; để trống = không dùng). App PC không còn đăng nhập bằng Google.">
              <TextBlock Text="Email Google" Classes="label"/><TextBox x:Name="GoogleBox" Watermark="ten@gmail.com"/>
            </StackPanel>
            <StackPanel x:Name="PassPanel" Width="190" Spacing="3"><TextBlock Text="Mật khẩu * (≥ 6 ký tự)" Classes="label"/><TextBox x:Name="PassBox" PasswordChar="•"/></StackPanel>
            <CheckBox x:Name="ActiveBox" Content="Đang dùng" IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,4" ToolTip.Tip="Bỏ chọn để khóa tài khoản"/>
          </WrapPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,14,0,8" Padding="0,10,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*">
              <TextBlock Text="Phân quyền" Classes="section" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <CheckBox Grid.Column="1" x:Name="CustomBox" Content="Chỉnh quyền riêng cho tài khoản này" IsCheckedChanged="OnCustomChanged"/>
              <TextBlock Grid.Column="2" x:Name="PermHint" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" Tag="keep"/>
            </Grid>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PermPanel" ItemSpacing="12" LineSpacing="12"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
