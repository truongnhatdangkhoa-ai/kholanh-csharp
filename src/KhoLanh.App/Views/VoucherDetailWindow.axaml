<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KhoLanh.App.Views.VoucherDetailWindow"
        Title="Chi tiết phiếu" Width="1000" Height="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBg}" Icon="/Assets/app.ico">
  <DockPanel Margin="18">
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock x:Name="HeadText" Classes="title"/>
          <TextBlock x:Name="InfoText" Classes="muted" TextWrapping="Wrap"/>
          <TextBlock x:Name="CancelText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="TotalText" FontWeight="SemiBold" Foreground="{StaticResource BrandMid}" VerticalAlignment="Bottom"/>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="CancelButton" Content="Hủy phiếu" Classes="danger" Click="OnCancel"/>
      <Button x:Name="CopyButton" Content="Lập phiếu mới giống phiếu này" Click="OnCopy"/>
      <Button Content="In phiếu" Classes="primary" Click="OnPrint"/>
      <Button Content="Đóng" IsCancel="True" Click="OnClose"/>
    </StackPanel>
    <DataGrid x:Name="LinesGrid">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Mã hàng" Binding="{Binding ProductCode}" Width="110"/>
        <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="*"/>
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/>
        <DataGridTextColumn Header="Lô" Binding="{Binding Lot}" Width="110"/>
        <DataGridTextColumn Header="Vị trí" Binding="{Binding Location}" Width="80"/>
        <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="75"/>
        <DataGridTextColumn Header="Số lượng" Binding="{Binding Quantity, StringFormat='#,0.##'}" Width="100"/>
        <DataGridTextColumn Header="Số kg" Binding="{Binding Weight, StringFormat='#,0.##'}" Width="90"/>
        <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
