<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KhoLanh.App.Views.EntryView">
  <!-- 1.54: bảng nhập liệu rộng hết trang (tab 1); danh sách trang / thùng rác ở tab riêng (tab 2). Đổi trang nhanh bằng ô chọn trang trên đầu bảng. -->
  <TabControl x:Name="Tabs">
    <TabItem Header="Bảng nhập liệu">
      <DockPanel Margin="0,8,0,0">
        <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,8">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Trang" Classes="muted" VerticalAlignment="Center"/>
              <ComboBox x:Name="PageCombo" Width="300" PlaceholderText="(chưa có trang)" SelectionChanged="OnComboSelected"/>
              <Button x:Name="NewButton" Content="+ Trang mới" Click="OnNew"/>
              <TextBlock x:Name="SaveState" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" ItemSpacing="6" LineSpacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="SaveButton" Content="Lưu (Ctrl+S)" Classes="primary" Click="OnSave"/>
              <Button x:Name="ImportButton" Content="Nhập Excel…" Click="OnImport"/>
              <Button x:Name="ExportButton" Content="Xuất Excel…" Click="OnExport"/>
              <Button x:Name="ColumnsButton" Content="Cột…" Click="OnColumns"/>
              <Button x:Name="TemplateButton" Content="Lưu thành mẫu…" Click="OnSaveTemplate"/>
              <Button x:Name="ReloadButton" Content="Tải lại" Click="OnReload"/>
            </WrapPanel>
          </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="8,5" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="HintText" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"
                       Text="Gõ là sửa · F2 / nhấp đúp sửa tiếp · Enter / Tab di chuyển · Ctrl+C / Ctrl+V chép dán với Excel · Delete xóa · Ctrl+Z hoàn tác · Ctrl+D điền xuống · chuột phải để chèn / xóa dòng"/>
            <TextBlock Grid.Column="1" x:Name="StatusText" FontSize="12" Margin="12,0,0,0"/>
          </Grid>
        </Border>
        <Panel x:Name="GridHost">
          <TextBlock x:Name="EmptyText" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     Text="Chưa có trang nào. Bấm “+ Trang mới” để bắt đầu nhập (chọn mẫu có sẵn hoặc bảng trống)."/>
        </Panel>
      </DockPanel>
    </TabItem>
    <TabItem Header="Danh sách trang">
      <DockPanel Margin="0,8,0,0">
        <Border DockPanel.Dock="Top" Classes="card" Padding="10,8" Margin="0,0,0,8">
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBox x:Name="SearchBox" Watermark="Tìm trang…" Width="280"/>
            <ToggleButton x:Name="TrashToggle" Content="Thùng rác" IsCheckedChanged="OnTrashToggle"/>
            <TextBlock x:Name="CountText" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
            <Border Width="16"/>
            <Button x:Name="OpenButton" Content="Mở trang" Classes="primary" Click="OnOpenPage"/>
            <Button x:Name="RenameButton" Content="Đổi tên" Click="OnRename"/>
            <Button x:Name="RestoreButton" Content="Khôi phục" Click="OnRestore" IsVisible="False"/>
            <Button x:Name="DeleteButton" Content="Xóa" Classes="danger" Click="OnDelete"/>
          </WrapPanel>
        </Border>
        <Border Classes="card" Padding="4">
          <ListBox x:Name="PageList" SelectionChanged="OnPageSelected" DoubleTapped="OnListDoubleTapped">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="4,3">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Line}" Classes="muted" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>
    </TabItem>
  </TabControl>
</UserControl>
