<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Bộ kiểu "Băng sạch" (1.43): màu lấy từ tài nguyên AppTheme (Sáng dịu / Tối thiết kế riêng).
       Kích thước chung: bước 4 px · nút / ô nhập cao 32 · bo 6 (ô nhỏ) / 8 (thẻ) / 12 (hộp thoại). -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>

  <!-- Thẻ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <!-- Chữ -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="12.5"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0"/>
  </Style>

  <!-- Nút: thường (viền) · primary (xanh, 1 nút / màn hình) · ghost (không viền) · danger (viền đỏ) -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="11,4"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Border}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource Faint}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentStrong}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentStrong}"/>
  </Style>

  <!-- 1.60: chữ trong nút biểu tượng + chữ (Icon.Label) theo màu chữ của nút (kiểu TextBlock chung đặt màu chữ thường → nút chính bị chữ tối) -->
  <Style Selector="Button.primary TextBlock"><Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/></Style>
  <Style Selector="Button.danger TextBlock"><Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/></Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource BrandMid}"/>
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BadSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
  </Style>

  <!-- Menu (1.87): thanh trắng 44px theo giao diện (trước nền xanh đậm) — mục đang mở chữ xanh nhấn, nền xanh nhạt + gạch chân xanh -->
  <Style Selector="Button.navtab">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource NavFg}"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="Height" Value="43"/>
    <Setter Property="MinHeight" Value="43"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0,0,0,3"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.navtab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="Button.navtab:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}"/>
  </Style>
  <Style Selector="Button.navtab.active">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Button.navtab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="Button.navtab TextBlock"><Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/></Style>
  <Style Selector="Button.navtab Path"><Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/></Style>
  <Style Selector="Button.navtab Border.navbadge TextBlock"><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Border.navbadge">
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="MinHeight" Value="18"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Background" Value="#E8892A"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem TextBlock, MenuFlyoutPresenter MenuItem AccessText">
    <Setter Property="Foreground" Value="{Binding $parent[MenuItem].Foreground}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem Path">
    <Setter Property="Stroke" Value="{Binding $parent[MenuItem].Foreground}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter Border.navbadge TextBlock"><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style Selector="MenuItem.navitem">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <Style Selector="MenuItem.navitem.current">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <!-- Ô tìm nhanh trên tầng 1 -->
  <Style Selector="Button.searchbox">
    <Setter Property="Width" Value="460"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource NavHover}"/>
    <Setter Property="BorderBrush" Value="#2D4A6C"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource NavMuted}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.searchbox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#24446A"/>
    <Setter Property="BorderBrush" Value="#3E6A98"/>
    <Setter Property="Foreground" Value="{DynamicResource NavFg}"/>
  </Style>
  <Style Selector="Button.searchbox TextBlock"><Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/></Style>
  <Style Selector="Border.kbd">
    <Setter Property="BorderBrush" Value="#3A5878"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="5,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Nút trên tầng 1 của menu ngang (trạng thái LAN, Trợ lý, tài khoản…) -->
  <Style Selector="Button.topnav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource NavFg}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.topnav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="Button.topnav:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHover}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="Button.topnav.active">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.topnav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
  </Style>

  <!-- Ô nhập -->
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ComboBox, CalendarDatePicker, NumericUpDown, AutoCompleteBox">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="CheckBox, RadioButton">
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <!-- Tab: chữ + gạch chân màu nhấn, không nền -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="2,4"/>
    <Setter Property="Margin" Value="0,0,18,0"/>
    <Setter Property="Foreground" Value="{DynamicResource BrandMid}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- 1.83: tab cấp 1 của trang nằm chung hàng tên trang (36px, MainWindow.AlignPageTabs) -->
  <Style Selector="TabControl.pagetabs > TabItem">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="Margin" Value="0,0,18,0"/>
  </Style>
  <Style Selector="TabControl.pagetabs /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Margin" Value="0,8,0,0"/>
  </Style>
  <Style Selector="TabControl.pagetabs > TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Margin" Value="0"/>
  </Style>
  <!-- 1.84 mẫu chuẩn: tab cấp 2 trở xuống (TabControl lồng / class seg) = NÚT GẠT, nằm đầu thanh công cụ (ToolRow tự kéo vào) -->
  <Style Selector="TabControl TabControl > TabItem, TabControl.seg > TabItem">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1,1,0,1"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:nth-child(1), TabControl.seg > TabItem:nth-child(1)">
    <Setter Property="CornerRadius" Value="6,0,0,6"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:nth-last-child(1), TabControl.seg > TabItem:nth-last-child(1)">
    <Setter Property="CornerRadius" Value="0,6,6,0"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:nth-child(1):nth-last-child(1), TabControl.seg > TabItem:nth-child(1):nth-last-child(1)">
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:selected, TabControl.seg > TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem /template/ Border#PART_SelectedPipe, TabControl.seg > TabItem /template/ Border#PART_SelectedPipe">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:pointerover /template/ Border#PART_LayoutRoot, TabControl.seg > TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
  </Style>
  <Style Selector="TabControl TabControl > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot, TabControl.seg > TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
  </Style>
  <Style Selector="TabControl TabControl /template/ ContentPresenter#PART_SelectedContentHost, TabControl.seg /template/ ContentPresenter#PART_SelectedContentHost">
    <Setter Property="Margin" Value="0,6,0,0"/>
  </Style>
  <!-- nút gạt dựng bằng code (Controls/Seg) -->
  <Style Selector="Border.seg">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="Height" Value="30"/>
  </Style>
  <Style Selector="ToggleButton.segitem">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.segitem:nth-last-child(1)">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ToggleButton.segitem:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <Style Selector="ToggleButton.segitem:checked">
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="ToggleButton.segitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style Selector="ToggleButton.segitem:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
  </Style>
  <!-- khung "Sửa thông tin" của InfoLine: bỏ MaxWidth 456 mặc định của FlyoutPresenter (1.127) -->
  <Style Selector="FlyoutPresenter.wide">
    <Setter Property="MaxWidth" Value="1200"/>
    <Setter Property="MaxHeight" Value="900"/>
  </Style>
  <!-- dòng tóm tắt thông tin phiếu (Controls/InfoLine) -->
  <Style Selector="Border.infoline">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="34"/>
  </Style>
  <!-- nhãn nhỏ (file đang dùng / nguồn so sánh) -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Surface2}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Nhãn trạng thái: nền nhạt + chữ đậm (Border.pill.ok / .warn / .bad / .info / .accent, chữ bên trong tự đổi màu) -->
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Border.pill.ok"><Setter Property="Background" Value="{DynamicResource OkSoft}"/></Style>
  <Style Selector="Border.pill.ok > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ok}"/></Style>
  <Style Selector="Border.pill.warn"><Setter Property="Background" Value="{DynamicResource WarnSoft}"/></Style>
  <Style Selector="Border.pill.warn > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warn}"/></Style>
  <Style Selector="Border.pill.bad"><Setter Property="Background" Value="{DynamicResource BadSoft}"/></Style>
  <Style Selector="Border.pill.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></Style>
  <Style Selector="Border.pill.info"><Setter Property="Background" Value="{DynamicResource InfoSoft}"/></Style>
  <Style Selector="Border.pill.info > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Info}"/></Style>
  <Style Selector="Border.pill.accent"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Style>
  <Style Selector="Border.pill.accent > TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentStrong}"/></Style>

  <!-- Bảng DataGrid (ít dùng; lưới chính là SheetGrid) -->
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="RowHeight" Value="32"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource GridHead}"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Gợi ý (tooltip) gọn -->
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <!-- 1.50: thanh cuộn luôn hiện cỡ lớn (Fluent mặc định thu thành vạch mảnh, phải rê / bấm mới to → cuộn chậm) -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False"/>
  </Style>
  <Style Selector="ScrollBar">
    <Setter Property="AllowAutoHide" Value="False"/>
  </Style>
  <Style Selector="ScrollBar:vertical">
    <Setter Property="MinWidth" Value="14"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="MinHeight" Value="14"/>
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource BorderStrong}"/>
  </Style>
</Styles>
