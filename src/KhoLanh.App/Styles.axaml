<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- Thẻ nền trắng -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="16"/>
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource BrandMid}"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource BrandDark}"/>
  </Style>

  <!-- Nút chính -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,8"/>
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1877B0"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>

  <!-- Menu ngang trên cùng -->
  <Style Selector="Button.topnav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#C9DCEB"/>
    <Setter Property="Padding" Value="9,8"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.topnav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#16405F"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.topnav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#1B4C70"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.topnav.active">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.topnav.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="MinHeight" Value="36"/>
  </Style>
  <Style Selector="DataGrid">
    <Setter Property="Background" Value="White"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="#E8EEF3"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CanUserResizeColumns" Value="True"/>
    <Setter Property="CanUserSortColumns" Value="True"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="RowHeight" Value="32"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="DataGridColumnHeader">
    <Setter Property="Background" Value="#EAF2F8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="8,0"/>
  </Style>
</Styles>
