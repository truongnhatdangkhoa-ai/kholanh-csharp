<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KhoLanh.App.MainWindow"
        Title="Kho Lạnh" Width="1360" Height="820" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="/Assets/app.ico"
        Background="{DynamicResource PageBg}">
  <!-- Khung "Băng sạch" (1.44): thanh bên trái (thu gọn được: Ctrl + B, rê chuột hiện tên ngay) + thanh đầu trang (tiêu đề + nút) + nội dung. -->
  <DockPanel>
    <Border x:Name="Side" DockPanel.Dock="Left" Width="232" Background="{DynamicResource NavBg}">
      <DockPanel>
        <Grid x:Name="LogoRow" DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="14,14,10,10">
          <Image Source="/Assets/logo.png" Width="30" Height="30" VerticalAlignment="Center"/>
          <StackPanel x:Name="LogoText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="KHO LẠNH" Foreground="White" FontWeight="Bold" FontSize="14.5"/>
            <TextBlock x:Name="WarehouseText" Foreground="{DynamicResource NavFg}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Margin="8,6,8,10" Spacing="2">
          <Button x:Name="LanPill" Classes="side" IsVisible="False" Click="OnLanPill">
            <Grid ColumnDefinitions="22,*">
              <Ellipse x:Name="LanDot" Width="9" Height="9" Fill="#3FB950" HorizontalAlignment="Center"/>
              <TextBlock x:Name="LanText" Grid.Column="1" Classes="sidelbl" FontSize="12" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Button>
          <Button x:Name="CollapseButton" Classes="side" Click="OnCollapseClick"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NavPanel" Margin="8,0,8,8" Spacing="1"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Thanh đầu trang: tiêu đề + mô tả, bên phải là tìm nhanh / thông báo / cập nhật / tài khoản -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,0,14,0" Height="56">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" FontSize="17" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="PageSubtitle" Classes="muted" VerticalAlignment="Center" Margin="14,2,12,0" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
          <Button x:Name="HelpButton" Classes="ghost" Click="OnHelpClick" ToolTip.Tip="Hướng dẫn màn hình này (các ghi chú đã thu gọn để bảng có thêm chỗ)"/>
          <Button x:Name="SearchButton" Classes="ghost" Click="OnSearchClick" ToolTip.Tip="Tìm mã hàng / size / vị trí / hợp đồng / phiếu / LSX / cont trong mọi module (Ctrl + K)"/>
          <Button x:Name="AutoButton" Classes="ghost" IsVisible="False" Foreground="{DynamicResource Warn}" Click="OnAutoClick"/>
          <Button x:Name="TroLyButton" Classes="ghost" IsVisible="False" Foreground="{DynamicResource Danger}" Click="OnTroLyClick"/>
          <Button x:Name="UpdateButton" Classes="primary" IsVisible="False" Click="OnUpdateClick"/>
          <TextBlock x:Name="VersionText" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
          <Button x:Name="UserButton" Classes="ghost">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="UserInfo" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Đổi mật khẩu" Click="OnChangePassword"/>
                <MenuItem Header="Khởi động cùng Windows…" Click="OnBootSettings"/>
                <MenuItem Header="Giao diện &amp; cỡ chữ…" Click="OnThemeSettings"/>
                <Separator/>
                <MenuItem Header="Đăng xuất" Click="OnLogout"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <ContentControl x:Name="PageHost" Margin="16"/>
    </Panel>
  </DockPanel>
</Window>
