<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KhoLanh.App.MainWindow"
        Title="Kho Lạnh" Width="1360" Height="820" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="/Assets/app.ico"
        Background="{DynamicResource PageBg}">
  <DockPanel>
    <!-- Thanh menu ngang -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource NavBg}" Padding="14,0">
      <Grid ColumnDefinitions="Auto,*,Auto" Height="54">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="0,0,10,0">
          <Image Source="/Assets/logo.png" Width="30" Height="30"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="KHO LẠNH" Foreground="White" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="WarehouseText" Foreground="#7FA3C0" FontSize="10.5"/>
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel x:Name="NavPanel" Orientation="Horizontal" Spacing="2"/>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="SearchButton" Classes="topnav" VerticalAlignment="Center" Margin="6,0,0,0" Click="OnSearchClick" ToolTip.Tip="Tìm mã hàng / size / vị trí / hợp đồng trong tồn mọi module, hoặc tên module (Ctrl + K)">
          <TextBlock Text="🔍 Tìm nhanh   Ctrl+K" FontSize="12.5"/>
        </Button>
        <Button x:Name="LanPill" Classes="topnav" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Click="OnLanPill">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="LanDot" Width="9" Height="9" Fill="#3FB950"/>
            <TextBlock x:Name="LanText" VerticalAlignment="Center" FontSize="12"/>
          </StackPanel>
        </Button>
        <Button x:Name="TroLyButton" Classes="topnav" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#FFB4A8" Click="OnTroLyClick"/>
        <Button x:Name="UpdateButton" Classes="primary" IsVisible="False" VerticalAlignment="Center" Margin="6,0,0,0" Padding="10,6" Click="OnUpdateClick"/>
        <Button x:Name="UserButton" Classes="topnav" VerticalAlignment="Center" Margin="6,0,0,0">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem x:Name="UserInfo" IsEnabled="False"/>
              <Separator/>
              <MenuItem Header="Đổi mật khẩu" Click="OnChangePassword"/>
              <MenuItem Header="Khởi động cùng Windows…" Click="OnBootSettings"/>
              <MenuItem Header="Giao diện &amp; cỡ chữ…" Click="OnThemeSettings"/>
              <Separator/>
              <MenuItem Header="Đăng xuất" Click="OnLogout"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Tiêu đề trang -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="20,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="PageTitle" Classes="title" FontSize="18" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" x:Name="PageSubtitle" Classes="muted" VerticalAlignment="Center" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" x:Name="VersionText" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Panel>
      <ContentControl x:Name="PageHost" Margin="16"/>
      <!-- 2 module gốc (WebView2) giữ sống suốt phiên, chỉ ẩn / hiện khi chuyển menu -->
    </Panel>
  </DockPanel>
</Window>
