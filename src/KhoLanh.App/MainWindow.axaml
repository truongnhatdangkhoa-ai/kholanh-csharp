<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KhoLanh.App.MainWindow"
        Title="Kho Lạnh" Width="1360" Height="820" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized" Icon="/Assets/app.ico"
        Background="{DynamicResource PageBg}">
  <!-- 1.83 "header gọn": 1 thanh 44px (logo · menu · LAN / Trợ lý / cập nhật · tài khoản), rồi 1 hàng 36px tên trang + tab cấp 1 của trang
       (TabControl đầu trang được kéo lên chung hàng — AlignPageTabs). Bỏ "Nhóm ›", mô tả (vào ⓘ), phiên bản vào menu tài khoản. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource NavBg}" Padding="10,0,8,0" Height="44">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image x:Name="LogoImage" Source="/Assets/logo.png" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="NavPanel" Orientation="Horizontal"/>
        </ScrollViewer>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
          <Button x:Name="LanPill" Classes="topnav" IsVisible="False" Click="OnLanPill">
            <Ellipse x:Name="LanDot" Width="10" Height="10" Fill="#3FB950" VerticalAlignment="Center"/>
          </Button>
          <Button x:Name="AutoButton" Classes="topnav" IsVisible="False" Foreground="#FFD27A" Click="OnAutoClick"/>
          <Button x:Name="TroLyButton" Classes="topnav" IsVisible="False" Foreground="#FFB4A8" Click="OnTroLyClick"/>
          <Button x:Name="UpdateButton" Classes="primary" IsVisible="False" Click="OnUpdateClick"/>
          <Button x:Name="UserButton" Classes="topnav">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem x:Name="UserInfo" IsEnabled="False"/>
                <MenuItem x:Name="VersionItem" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Đổi mật khẩu" Click="OnChangePassword"/>
                <MenuItem Header="Khởi động cùng Windows…" Click="OnBootSettings"/>
                <MenuItem Header="Giao diện &amp; cỡ chữ…" Click="OnThemeSettings"/>
                <Separator/>
                <MenuItem Header="Đăng xuất" Click="OnLogout"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Panel>
      <!-- nền hàng tên trang (tab đầu trang nằm đè lên dải này) -->
      <Border x:Name="PageBand" Height="36" VerticalAlignment="Top" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"/>
      <ContentControl x:Name="PageHost" Margin="12,42,12,8"/>
      <!-- tên trang · vạch · (tab của trang nằm bên dưới lớp này) · ⓘ — lớp không nền nên bấm xuyên xuống tab -->
      <Grid Height="36" VerticalAlignment="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,0,6,0">
        <TextBlock x:Name="PageTitle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
        <Rectangle Grid.Column="1" x:Name="PageSep" Width="1" Height="18" Fill="{DynamicResource BorderStrong}" Margin="14,0,0,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" x:Name="PageSubtitle" Classes="muted" VerticalAlignment="Center" Margin="14,0,12,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
        <Border Grid.Column="2" x:Name="PageExtra" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="620" MaxHeight="36" ClipToBounds="True" Margin="0,0,6,0"/>
        <Button Grid.Column="3" x:Name="HelpButton" Classes="ghost" MinHeight="28" Padding="6,2" Click="OnHelpClick" VerticalAlignment="Center" ToolTip.Tip="Hướng dẫn màn hình này (các ghi chú đã thu gọn để bảng có thêm chỗ)"/>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
